def to_kanda(n: int):
    kandas = [
        {"name": "बालकाण्डम्", "in": "बालकाण्डे"},
        {"name": "अयोध्याकाण्डम्", "in": "अयोध्याकाण्डे"},
        {"name": "अरण्यकाण्डम्", "in": "अरण्यकाण्डे"},
        {"name": "किष्किन्धाकाण्डम्", "in": "किष्किन्धाकाण्डे"},
        {"name": "सुन्दरकाण्डम्", "in": "सुन्दरकाण्डे"},
        {"name": "युद्धकाण्डम्", "in": "युद्धकाण्डे"},
        {"name": "उत्तरकाण्डम्", "in": "उत्तरकाण्डे"},
    ]
    k = kandas[n - 1]
    return k["name"], k["in"]


def el_escape(x: str) -> str:
    return x.replace("&", "&amp;").replace("<", "&lt;")


def attr_escape(x: str) -> str:
    return el_escape(x).replace('"', "&quot;")


def tx(x: str) -> str:
    return el_escape(unicodedata.normalize("NFC", x))


def get_uuids_for_work(fn: str) -> list:
    if not os.path.exists(fn):
        return []
    with open(fn, "r", encoding="utf-8") as f:
        uuids = [x for x in f.read().split("\n") if x.strip()]
    uuids.reverse()
    return uuids


def uuid_for(loc: str, uuids: list) -> str:
    if uuids:
        return uuids.pop()
    return str(uuid.uuid5(UUID_NAMESPACE, loc))


def write_text(path: str, data: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write(data)


def set_data(dx: dict, x: str) -> None:
    kanda = int(x[0])
    sarga = int(x[1:4])
    verse = int(x[5:7])
    ps = x[9:].split(";")
    if kanda not in dx:
        dx[kanda] = {}
    sx = dx[kanda]
    if sarga not in sx:
        sx[sarga] = {}
    vx = sx[sarga]
    if verse not in vx:
        vx[verse] = []
    ys = vx[verse]
    for i in range(0, len(ps)):
        p = chr(i + ord(x[7:8]))
        ys.append((p, ps[i].lstrip()))


def sarga_url(kanda: int, sarga: int) -> str:
    """Public, extensionless path of one sarga: what an xref @url names."""
    return "/sa/i/" + SITE_SLUG + "/" + str(kanda) + "/" + str(sarga).zfill(3)


def meta_block(title_text: str, prev_url=None, summary: str = "") -> str:
    ys = []
    ys.append("<meta>")
    ys.append("<copyright>" + tx(COPYRIGHT) + "</copyright>")
    ys.append("<source>" + tx(title + " " + SOURCE_SUFFIX) + "</source>")
    ys.append("<title>" + tx(title_text) + "</title>")
    if summary:
        ys.append("<summary>" + tx(summary) + "</summary>")
    ys.append("<reviewer>" + tx(REVIEWER) + "</reviewer>")
    if prev_url is not None:
        ys.append('<xref rel="prev" url="' + attr_escape(prev_url) + '"/>')
    ys.append("</meta>")
    return "\n".join(ys)


def kanda_list_doc(u: str) -> str:
    ys = []
    ys.append('<document uuid="' + attr_escape(u) + '">')
    ys.append(meta_block(title + " BCE"))
    ys.append("<matter>")
    ys.append("<list>")
    for k in range(1, 7 + 1):
        k_name, _k_in = to_kanda(k)
        ys.append(
            '<li><ref url="/sa/i/'
            + SITE_SLUG
            + "/"
            + str(k)
            + '/">'
            + tx(k_name)
            + "</ref></li>"
        )
    ys.append("</list>")
    ys.append("</matter>")
    ys.append("</document>")
    return "\n".join(ys) + "\n"


def sarga_list_doc(u: str, k: int, k_name: str, xs: list) -> str:
    ys = []
    ys.append('<document uuid="' + attr_escape(u) + '">')
    ys.append(meta_block(k_name))
    ys.append("<matter>")
    ys.append(
        '<x-list path="/sa/i/'
        + SITE_SLUG
        + "/"
        + str(k)
        + '" depth="0" exclude="index.xml"/>'
    )
    ys.append("</matter>")
    ys.append("</document>")
    return "\n".join(ys) + "\n"


def sarga_doc(
    u: str,
    slug: str,
    kanda: int,
    k_name: str,
    k_in: str,
    sarga: int,
    verses: dict,
    last: bool,
    prev_url=None,
    summary: str = "",
    hook: str = "",
    beats: str = "",
) -> str:
    ys = []
    ys.append('<document uuid="' + attr_escape(u) + '" x-slug="' + slug + '">')
    ys.append(meta_block("सर्गः " + to_devanagari_no(sarga), prev_url, summary))
    ys.append("<matter>")
    if hook or beats:
        ys.append('<section lang="en">')
        if hook:
            ys.append('<p type="hook">' + tx(hook) + "</p>")
        if beats:
            ys.append('<p type="beats">' + tx(beats) + "</p>")
        ys.append("</section>")
    for verse in verses.keys():
        xps = verses[verse]
        is_split = len(xps) > 2 and [x for x in xps if x[0] in SPLIT_PADA_IDS]
        ys.append('<vg id="' + str(kanda) + "." + str(sarga) + "." + str(verse) + '">')
        for p, xp in enumerate(xps):
            pid, ptext = xp
            if p == len(xps) - 1:
                suffix = "॥ " + to_devanagari_no(verse)
            elif is_split:
                suffix = "।" if pid in SPLIT_PADA_IDS else ""
            else:
                suffix = "।"
            ys.append("<v>" + tx(ptext + suffix) + "</v>")
        ys.append("</vg>")
    ys.append('<vg id="sarga-end">')
    ys.append(
        "<v>"
        + tx(
            "इति श्रीरामायणे "
            + k_in
            + " "
            + to_ord_sarga(sarga)
            + " सर्गः॥ "
            + to_devanagari_no(sarga)
        )
        + "</v>"
    )
    ys.append("</vg>")
    if last:
        ys.append('<vg id="kanda-end">')
        ys.append("<v>" + tx("॥ समाप्तं " + k_name + " ॥") + "</v>")
        ys.append("</vg>")
    ys.append("</matter>")
    ys.append("</document>")
    return "\n".join(ys) + "\n"


def consolidate(sd: str) -> dict:
    names = sorted(n for n in os.listdir(sd) if n.endswith(".txt"))[1:]
    xs = []
    for name in names:
        fp = os.path.join(sd, name)
        print(fp)
        with open(fp, "r", encoding="utf-8") as f:
            for x in f.read().split("\n"):
                if not x or x.startswith("%"):
                    continue
                if "=" in x:
                    print("QQQ" + x + "QQQ")
                xs.append(x)
    dx: dict = {}
    for x in xs:
        if "=" in x:
            print("~~~" + x + "~~~")
        set_data(dx, x)
    return dx


def reading_order(dx: dict) -> list:
    """Every (kanda, sarga) in reading order: kanda ascending, then sarga.

    Kept separate from the dict iteration order below, which must stay as it
    is: uuids are assigned by call order, so reordering the writes would
    change every document's uuid.
    """
    return [(k, s) for k in sorted(dx.keys()) for s in sorted(dx[k].keys())]


def generate(sd: str, dd: str) -> None:
    dx = consolidate(sd)
    uuids = get_uuids_for_work(os.path.join(sd, "ids"))
    uuid_map = load_uuid_map(sd)
    text_map = load_text_map(sd, ("summaries", "hooks", "beats"))

    def resolve_uuid(key: str, loc: str) -> str:
        if key in uuid_map:
            return uuid_map[key]
        return uuid_for(loc, uuids)

    order = reading_order(dx)
    prev_of = {}
    for i in range(1, len(order)):
        prev_of[order[i]] = order[i - 1]
    write_text(
        os.path.join(dd, "index.xml"),
        kanda_list_doc(resolve_uuid("index", "sa/i/" + SITE_SLUG + "/index.xml")),
    )
    for kanda in dx.keys():
        xss = list(dx[kanda].keys())
        k_name, k_in = to_kanda(kanda)
        write_text(
            os.path.join(dd, str(kanda), "index.xml"),
            sarga_list_doc(
                resolve_uuid(
                    str(kanda), "sa/i/" + SITE_SLUG + "/" + str(kanda) + "/index.xml"
                ),
                kanda,
                k_name,
                xss,
            ),
        )
        for s, sarga in enumerate(xss):
            sarga_label = str(sarga).zfill(3)
            skey = f"{kanda}.{sarga_label}"
            write_text(
                os.path.join(dd, str(kanda), sarga_label + ".xml"),
                sarga_doc(
                    resolve_uuid(
                        skey,
                        "sa/i/"
                        + SITE_SLUG
                        + "/"
                        + str(kanda)
                        + "/"
                        + sarga_label
                        + ".xml",
                    ),
                    sarga_label,
                    kanda,
                    k_name,
                    k_in,
                    sarga,
                    dx[kanda][sarga],
                    s == len(xss) - 1,
                    None
                    if (kanda, sarga) not in prev_of
                    else sarga_url(*prev_of[(kanda, sarga)]),
                    text_map.get(("summaries", skey), ""),
                    text_map.get(("hooks", skey), ""),
                    text_map.get(("beats", skey), ""),
                ),
            )


def main(argv: list) -> None:
    srcdir = argv[1]
    destdir = argv[2]
    print(srcdir)
    print(destdir)
    generate(srcdir, os.path.join(destdir, "www", "sa", "i", SITE_SLUG))


if __name__ == "__main__":
    main(sys.argv)
