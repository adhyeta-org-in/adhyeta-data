#!/usr/bin/env python3
"""Valmikiramayanam Baroda Critical Edition translator.

Reads the BCE e-text from the srcdir passed as argv[1] (this script's own
directory: Ram00.txt-Ram07.txt plus the checked-in `ids` uuid list) and
writes finished adoc documents as .xml files under the staging dir passed
as argv[2], at the old pipeline's site paths (www/sa/i/<slug>/...).

Faithful port of the old ingest (ramayana_bce.py); boundaries, meta and
uuid assignment match it exactly:
- Content comes from every *.txt in srcdir, sorted, minus the first one.
  That first file is Ram00.txt (header prose plus the John D. Smith
  credit); the old code dropped it with .tail(), so the credit is unused
  here exactly as it was there. The `ids` file is never parsed as content
  (it is not *.txt).
- Uuids are the non-blank lines of <srcdir>/ids, reversed once, then
  popped so the first document takes the first ids line. Assignment order
  is the old one: the kanda list, then per kanda in first-seen order the
  sarga list followed by its sargas. When ids run out, the fallback is a
  deterministic uuid5 of the site path; uuids are never random, so output
  is byte-identical across runs.
- Meta per document mirrors the old code: copyright "CC0. No rights
  reserved", source "<work title> Baroda Critical Edition", title per doc
  kind ("<work> BCE", kanda name, "सर्गः <n>"), reviewer "Karthik Iyer".
  Sarga documents also carry an explicit @x-slug (the zero-padded sarga
  number, matching the output file stem) so page URLs stay numeric.
- Verse groups mirror the old rendering: `;`-split padas lettered from
  the line's pada slot, single-danda closers except after b/d/f/h padas
  of long verses, sarga-end and (last sarga only) kanda-end closers.
- Every sarga carries one `xref @rel="prev"` naming the sarga before it
  in reading order (kanda ascending, then sarga number), so the whole
  work is one chain from 1.1 to the last sarga of kanda 7; the first
  sarga has no prev. `next` is derived at publish by inverting prev,
  which is why only prev is authored: a link must point at something
  that already exists.
- Text is NFC-normalized (SSG requires NFC sources).

Deliberate deviations, forced by the new schema (the translator, never
the schema, absorbs them):
- Verse-group @ids mirror the old pipeline (k.s.v, sarga-end, kanda-end);
  @id values are never slugged, only rendered verbatim.
- Output is canonical XML written directly (no sxml round trip); the
  translator must not slug -- page slugs come from titles via make_slug
  at publish time, so only titles are set here.

Stdlib only. No timestamps, no randomness.
"""

import os
import sys
import unicodedata
import uuid

# English telling lives beside the e-text as plain TSVs: hooks.tsv,
# beats.tsv and summaries.tsv hold one "<kanda>.<sarga> TAB text" line
# per sarga, and uuids.tsv holds one "<key> TAB <uuid>" line per
# document (index, each kanda, each sarga). All four are read directly
# from this translator's own srcdir; no shared tools/ store is needed.
def load_text_map(sd: str, kinds) -> dict:
    out: dict = {}
    for kind in kinds:
        fp = os.path.join(sd, kind + ".tsv")
        if not os.path.exists(fp):
            continue
        with open(fp, "r", encoding="utf-8") as f:
            for line in f.read().split("\n"):
                if not line.strip():
                    continue
                key, _, text = line.partition("\t")
                if key and text:
                    out[(kind, key.strip())] = text.strip()
    return out


def load_uuid_map(sd: str) -> dict:
    fp = os.path.join(sd, "uuids.tsv")
    out: dict = {}
    if not os.path.exists(fp):
        return out
    with open(fp, "r", encoding="utf-8") as f:
        for line in f.read().split("\n"):
            if not line.strip():
                continue
            key, _, val = line.partition("\t")
            if key and val:
                out[key.strip()] = val.strip()
    return out

SITE_SLUG = "valmikiramayanam-bce"
SOURCE_SUFFIX = "Baroda Critical Edition"
COPYRIGHT = "CC0. No rights reserved"
REVIEWER = "Karthik Iyer"
UUID_NAMESPACE = uuid.NAMESPACE_URL
SPLIT_PADA_IDS = ("b", "d", "f", "h")


title = "वाल्मीकिरामायणम्"


def to_devanagari_no(n: int):
    nos = ["०", "१", "२", "३", "४", "५", "६", "७", "८", "९"]

    y = ""
    for x in str(n):
        y += nos[int(x)]
    return y


